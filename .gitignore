# Dependencies. The game itself still ships with zero runtime dependencies —
# node_modules/ here is dev-only tooling (Playwright, for the e2e test suite
# in tests/e2e/). package-lock.json IS committed (not ignored) so CI and
# every contributor install the exact same versions.
node_modules/
npm-debug.log*

# Playwright
test-results/
playwright-report/
tests/e2e/*.png

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Local scratch / temp
*.tmp
.tmp/
